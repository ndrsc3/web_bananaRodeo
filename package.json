{
    "name": "banana-rodeo",
    "version": "1.0.0",
    "description": "A website",
    "private": true,
    "type": "module",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint src/ api/ lib/ vite.config.ts",
        "format": "prettier --write src/ api/ scripts/ vite.config.ts *.json",
        "hash-password": "tsx scripts/hash-password.ts",
        "reset-counters": "tsx scripts/reset-counters.ts",
        "typecheck": "tsc --noEmit",
        "test": "node --test 'scripts/*.test.mjs'",
        "smoke": "node scripts/smoke-api.mjs",
        "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run smoke",
        "dev:check": "node scripts/dev-check.mjs",
        "dev:full": "node scripts/dev-check.mjs && vercel dev",
        "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/node": "^20.11.0",
        "@vercel/node": "^4.0.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.0.0",
        "jiti": "^2.6.1",
        "prettier": "^3.0.0",
        "rimraf": "^5.0.5",
        "tsx": "^4.0.0",
        "typescript": "^5.3.3",
        "typescript-eslint": "^8.0.0",
        "vite": "^6.0.0"
    },
    "dependencies": {
        "@upstash/redis": "^1.34.6",
        "@vercel/kv": "^0.2.4"
    }
}
